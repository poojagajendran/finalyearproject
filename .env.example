# ==========================================
# SHOPCART GLOBAL CONFIGURATION (.env)
# ==========================================
APP_ENV=development
SECRET_KEY=shopcart-super-secure-production-grade-key-at-least-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SHOPCART BACKEND ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Primary Postgres with pgvector; Fallback SQLite for local standalone development/testing
DATABASE_URL=sqlite+aiosqlite:///./shopcart.db
POSTGRES_DATABASE_URL=postgresql+asyncpg://shopcart:shopcart_secret@localhost:5432/shopcart_db

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# --- SIMBANK SERVICE ---
SIMBANK_HOST=0.0.0.0
SIMBANK_PORT=8001
SIMBANK_URL=http://localhost:8001
SIMBANK_DATABASE_URL=sqlite+aiosqlite:///./simbank.db
SIMBANK_POSTGRES_DATABASE_URL=postgresql+asyncpg://simbank:simbank_secret@localhost:5433/simbank_db
SIMBANK_WEBHOOK_SECRET=simbank-hmac-sha256-webhook-shared-secret-key-shopcart
SIMBANK_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhooks/simbank

# --- ANTHROPIC AI SHOPPING AGENT ---
# For development/demo without an active Anthropic API key, set MOCK_ANTHROPIC=true
ANTHROPIC_API_KEY=mock-key-or-set-anthropic-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
MOCK_ANTHROPIC=true
